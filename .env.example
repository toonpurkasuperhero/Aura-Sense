# AuraSense Environment Configuration Example
# Copy this file to .env to override defaults locally.

# Gemma 4 Runtime (Local Ollama)
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma4:e4b
GEMMA_TEMPERATURE=0.2
GEMMA_NUM_CTX=16384
GEMMA_TIMEOUT_S=300

# Audio Processing Mode: auto | native | spectrogram
AURA_AUDIO_MODE=auto
AURA_WHISPER_MODEL=base

# Optional Remote Notifications (Leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Business / ROI Assumptions (INR ₹)
AURA_DOWNTIME_COST_INR=25000
AURA_AVG_BREAKDOWN_HOURS=8
